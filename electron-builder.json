{
  "appId": "com.airoute.app",
  "productName": "AiRoute",
  "directories": {
    "output": "app/dist-electron",
    "buildResources": "build"
  },
  "files": [
    "app/main/**/*",
    "app/renderer/dist/**/*",
    "app/server/**/*",
    "package.json",
    {
      "from": ".build-node_modules/node_modules",
      "to": "node_modules"
    }
  ],
  "asarUnpack": [
    "node_modules/node-pty/**"
  ],
  "npmRebuild": false,
  "win": {
    "target": "portable",
    "icon": "app/renderer/public/icon.ico",
    "artifactName": "AiRoute.exe"
  },
  "afterPack": "scripts/after-pack.js",
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "artifactName": "AiRoute-${version}-${arch}.dmg",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null,
    "extendInfo": {
      "LSUIElement": false,
      "NSHighResolutionCapable": true
    }
  },
  "dmg": {
    "title": "AiRoute ${version}",
    "backgroundColor": "#F5F5F7",
    "window": {
      "width": 560,
      "height": 360
    },
    "icon": "build/icon.icns",
    "contents": [
      { "x": 150, "y": 190 },
      { "x": 410, "y": 190, "type": "link", "path": "/Applications" }
    ]
  }
}
