{
  "appId": "com.airoute.app",
  "productName": "AiRoute",
  "directories": {
    "output": "app/dist-electron"
  },
  "files": [
    "app/main/**/*",
    "app/renderer/dist/**/*",
    "app/server/**/*",
    "package.json",
    {
      "from": ".build-node_modules/node_modules",
      "to": "node_modules"
    }
  ],
  "win": {
    "target": "portable",
    "icon": "app/renderer/public/icon.ico",
    "artifactName": "AiRoute.exe"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "icon": "app/renderer/public/icon.png",
    "artifactName": "AiRoute-${version}-${arch}.${ext}",
    "darkModeSupport": true,
    "identity": "-",
    "hardenedRuntime": false
  }
}
