{
  "appId": "com.airoute.app",
  "productName": "AiRoute",
  "directories": {
    "output": "app/dist-electron"
  },
  "files": [
    "app/main/**/*",
    "app/renderer/dist/**/*",
    "app/server/**/*",
    "package.json",
    {
      "from": ".build-node_modules/node_modules",
      "to": "node_modules"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "app/renderer/public/icon.ico",
    "artifactName": "AiRoute-${version}-${arch}.${ext}"
  },
  "nsis": {
    "artifactName": "AiRoute-${version}-${arch}-setup.${ext}",
    "buildUniversalInstaller": false,
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AiRoute",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  },
  "portable": {
    "artifactName": "AiRoute-${version}-${arch}-portable.${ext}",
    "buildUniversalInstaller": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "icon": "assets/icon-mac.png",
    "artifactName": "AiRoute-${version}-${arch}.${ext}",
    "darkModeSupport": true,
    "identity": "-",
    "hardenedRuntime": false
  }
}
