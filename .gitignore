# 依赖
node_modules/

# 敏感配置（含 API Key）
server/models.json
docs/

# 运行时数据
server/logs/
server/state.json
server/token-stats.json
server/benchmark-questions.json
server/benchmark-runs.json
server/fallback.json
server/rules.json
server/server-config.json

# WorkBuddy 账号凭证与池状态（含明文 accessToken/refreshToken，严禁提交）
server/workbuddy-auths/
server/workbuddy-state.json

# 十个账号渠道的凭据、账号池与状态（channel-credentials.json 是明文，严禁提交）
server/channels-data/

# WorkBuddy 用量统计（运行时数据）
server/usage.json

# WorkBuddy 积分历史（运行时数据）
server/credit-history.json

# WorkBuddy 版本号缓存（运行时数据）
server/version-cache.json

# 工具本地数据
.codebuddy/
# pnpm dev:isolated 的独立 Electron 用户目录（与正式版单实例锁隔离）
.dev-userdata/
.claude/
.workbuddy-ai/
# lockfile
pnpm-lock.yaml
app/package-lock.json

# 构建产物
app/release/
app/server/
app/renderer/dist/
app/dist-electron/

# 构建脚本重命名的旧依赖目录（删除失败时的残留）
.build-node_modules.old.*

# IDE
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db
BLOG.md
