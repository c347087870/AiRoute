    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.0",
